# 복사해서 .env 로 사용 (.env 는 절대 커밋 금지)

# LLM
OPENAI_API_KEY=
LLM_PRIMARY_MODEL=gpt-5-nano
LLM_FAST_MODEL=gpt-5-nano
LLM_FALLBACK_MODEL=gpt-5-nano
EMBEDDING_MODEL=text-embedding-3-small

# LangSmith (선택, 없으면 로컬 로그로 대체)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skala-team1-capstone

# Auth
JWT_SECRET=change-me-to-a-32-byte-or-longer-random-string
SERVICE_TOKEN=change-me-internal-service-token

# Postgres
POSTGRES_DB=capstone
POSTGRES_USER=capstone
POSTGRES_PASSWORD=capstone

# Docker 내부 전용 계정. 각 URL의 비밀번호를 교체하고 URL 특수문자는 인코딩한다.
# db-access가 최초 계정을 생성하며 기존 계정의 비밀번호는 변경하지 않는다.
DATABASE_URL=postgresql://agent:change-me-agent-password@postgres:5432/capstone
RAG_DATABASE_URL=postgresql://rag_ro:change-me-rag-reader-password@postgres:5432/capstone
RAG_INDEX_DATABASE_URL=postgresql://rag_indexer:change-me-rag-indexer-password@postgres:5432/capstone

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# 공용 에이전트 (translator·summarizer)
# agent 가 요약 카드를 요청할 내부 주소 (메인→서브·서브→상담사 인계 노드에서 호출)
SUMMARIZER_URL=http://summarizer:8002
